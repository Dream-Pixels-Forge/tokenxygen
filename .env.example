# TokenSaver Environment Configuration
# Copy this to .env and fill in your values

# OpenAI API Key (required for OpenAI provider)
OPENAI_API_KEY=sk-your-key-here

# Optional: Anthropic API Key
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Google API Key
# GOOGLE_API_KEY=your-key-here

# Optional: Ollama host (if running remotely)
# OLLAMA_HOST=http://localhost:11434

# Data directory
TOKENDATA_DIR=/data

# Logging
TOKENSAVER_LOG_LEVEL=INFO
TOKENSAVER_JSON_LOGS=false

# Budget
TOKENSAVER_DAILY_BUDGET=10.0

# Proxy
TOKENSAVER_HOST=0.0.0.0
TOKENSAVER_PORT=8420
TOKENSAVER_DASHBOARD_PORT=8421
